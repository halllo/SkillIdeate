{
  "name": "skillideate",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspace api && npm run build --workspace web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
